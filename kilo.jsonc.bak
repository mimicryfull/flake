{
  "$schema": "https://app.kilo.ai/config.json",
  // Auto Efficient chooses a cost-effective model dynamically per task.
  "model": "kilo-auto/efficient",
  "subagent_model": "kilo-auto/efficient",
  "agent": {
    "code": { "model": "kilo-auto/efficient", "steps": 22 },
    "debug": { "model": "kilo-auto/efficient", "steps": 18 },
    "plan": { "model": "kilo-auto/efficient", "steps": 9 },
    "explore": { "model": "z-ai/glm-5.3-flash", "steps": 8 },
    "compaction": { "model": "kilo-auto/small" },
    "title": { "model": "kilo-auto/small" },
    "summary": { "model": "kilo-auto/small" }
  },
  "compaction": {
    "auto": true,
    "threshold_percent": 80,
    "prune": true
  },
  "lsp": true
}
