{
	"schemaVersion": 1,
	"id": "flake",
	"version": "${version}",
	"name": "Flake",
	"description": "",
	"license": "CC0-1.0",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.flake.bootstrap.FlakeMod",
			"dev.flake.bootstrap.FlakeNetworking"
		],
		"client": [
			"dev.flake.client.FlakeClient",
			"dev.flake.client.ui.FlakeUiClient"
		]
	},
	"mixins": [
		"flake.duel.mixins.json",
